root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Windows PowerShell 5.1 cần BOM để đọc đúng tiếng Việt
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.cmd]
charset = latin1
end_of_line = crlf

[*.{yml,yaml,json,md,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
